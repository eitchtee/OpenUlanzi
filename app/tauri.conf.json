{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenUlanzi",
  "version": "1.5.0",
  "identifier": "io.github.openulanzi",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenUlanzi",
        "width": 1440,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 660,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "volume",
        "title": "OpenUlanzi volume",
        "url": "volume.html",
        "width": 300,
        "height": 60,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "OpenUlanzi",
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
